# Public site URL used for metadata, emails and OAuth callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# In production, leave demo images off after replacing sample imagery with Cloudinary/store assets.
NEXT_PUBLIC_DEMO_ASSETS_ENABLED="false"
# Optional: set NEXT_PUBLIC_INTRO_PRELOADER_ENABLED=true to enable the intro in production.

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meri_shop?schema=public"

# Auth.js (NextAuth). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-string-at-least-32-characters"
AUTH_URL="http://localhost:3000"

# Optional Playwright E2E database. Use a separate database whose name contains "e2e" or "test".
E2E_DATABASE_URL=""

# Payment provider: mock | razorpay. Business logic only sees PaymentProvider.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Image storage provider.
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional email: console | resend.
# EMAIL_FROM defaults to the brand name and contact email in src/config/site.config.ts.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM=""

# SMS: console (add Twilio/MSG91 adapter later).
SMS_PROVIDER="console"
SMS_SENDER_ID=""

# Logging: debug | info | warn | error.
LOG_LEVEL="info"

# Demo seed only. The seed refuses production unless ALLOW_DEMO_SEED=true.
# Production seeding also requires explicit admin/customer passwords.
ALLOW_DEMO_SEED="false"
SEED_ADMIN_EMAIL="admin@diamondselection.example"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_CUSTOMER_EMAIL="customer@diamondselection.example"
SEED_CUSTOMER_PASSWORD="Customer@12345"
